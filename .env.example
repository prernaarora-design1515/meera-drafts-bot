# Copy this file to .env for local scripts, and add the same values
# in Vercel: Project → Settings → Environment Variables.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Any random string you choose (letters, numbers, _ and - only).
# Telegram sends it back on every webhook call so the bot can reject fake requests.
TELEGRAM_WEBHOOK_SECRET=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-3.8-flash

# Optional but recommended: comma-separated Telegram chat IDs allowed to use the bot.
# Leave empty to allow anyone. Send /id to the bot to find a chat ID.
ALLOWED_CHAT_IDS=

# Only needed for `npm run set-webhook`: your deployed Vercel URL
VERCEL_URL_FOR_WEBHOOK=https://your-project.vercel.app
